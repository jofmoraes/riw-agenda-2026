{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "riw-agenda-2026",
  "main": "./src/worker.js",
  "compatibility_date": "2026-08-05",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  }
}
